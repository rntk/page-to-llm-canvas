{
  "name": "pagetollm-canvas-extension",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "vite": "^8.0.1",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "dev": "node scripts/build-extension.mjs --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:report": "node scripts/check-coverage.mjs",
    "test:mutation": "PATH=\"$PWD/bin:$PATH\" stryker run"
  }
}
