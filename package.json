{
  "name": "pagetollm-canvas-extension",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "dev": "node scripts/build-extension.mjs --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:report": "node scripts/check-coverage.mjs",
    "test:property": "vitest run **/*.property.test.*",
    "test:mutation": "stryker run",
    "test:mutation:since": "stryker run --incremental",
    "test:advanced": "npm run test:property && npm run test:mutation",
    "lint": "eslint . && stylelint '**/*.css'",
    "lint:fix": "eslint . --fix && stylelint '**/*.css' --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
