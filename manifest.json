{
  "manifest_version": 3,
  "name": "PageToLLMCanvas",
  "version": "0.1.0",
  "description": "Pick blocks on any page, summarize and explore topics in an in-page canvas.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; form-action 'none'; base-uri 'none'; frame-src 'none'"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["chat.css", "content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "modal.html",
        "modal.js",
        "chat.css",
        "modal.css",
        "content-selection.js",
        "content-in-page-rail.js",
        "content-youtube-rail.js",
        "content-record-frame.js",
        "content-chunks/*.js",
        "content-assets/*"
      ],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
